@echo off
:: =====================================================================
:: Vendor Ledger System - Automated System Updater
:: نظام مبيعات وحسابات أولاد داؤود - سكربت التحديث التلقائي المطور
:: =====================================================================
title تحديث نظام أولاد داؤود للفواكه تلقائياً
color 0A
chcp 65001 >nul

echo ============================================================
echo   تحديث نظام أولاد داؤود للفواكه من مستودع السحابة...
echo ============================================================
echo.

:: 1. Fetch updates
echo [1/3] جاري جلب التحديثات الجديدة من Github...
git pull origin main
if %errorlevel% neq 0 (
    echo [تنبيه] فشل السحب المباشر من الفرع الرئيسي، جاري المحاولة بشكل عام...
    git pull
)

:: 2. Install dependencies
echo.
echo [2/3] جاري تنزيل الحزم البرمجية الجديدة (npm install)...
call npm install
if %errorlevel% neq 0 (
    echo [خطأ] فشل تثبيت الحزم الجديدة. يرجى التحقق من اتصال الإنترنت.
    pause
    exit /b 1
)

:: 3. Build application
echo.
echo [3/3] جاري إعادة بناء ملفات الواجهة (npm run build)...
call npm run build
if %errorlevel% neq 0 (
    echo [خطأ] فشلت عملية بناء التطبيق.
    pause
    exit /b 1
)

echo.
echo ============================================================
echo   ✨ تم تحديث وترقية نظام أولاد داؤود والتحميل بالكامل بنجاح!
echo ============================================================
echo.
echo يمكنك الآن إغلاق هذه النافذة وتحديث صفحة المتصفح (F5).
echo.
pause
